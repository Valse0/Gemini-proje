<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug network security config.

  Earlier versions allowed cleartext HTTP to 10.0.2.2/localhost so debug builds
  could reach a local translation backend. Translation is now fully on-device
  and the only network use is HTTPS language-pack downloads handled by Google
  ML Kit, so no cleartext exception is needed any more and none is granted.

  A same-named file must exist in every build variant (the manifest references
  @xml/network_security_config); see src/release/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
